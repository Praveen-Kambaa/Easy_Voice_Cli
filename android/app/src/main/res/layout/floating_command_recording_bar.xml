<?xml version="1.0" encoding="utf-8"?>
<!-- Compact recording card — anchored beside floating bubble -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/command_recording_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_command_glass_card"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/command_recording_pulse"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/floating_command_recording_dot" />

    <com.typeeasy.SoundWaveOverlayView
        android:id="@+id/command_recording_wave"
        android:layout_width="52dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp" />

    <TextView
        android:id="@+id/command_recording_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:fontFamily="monospace"
        android:minWidth="36dp"
        android:text="0:00"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/command_btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="Cancel"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/command_btn_confirm"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/floating_command_send_btn"
        android:gravity="center"
        android:text="⏹"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Hidden — pause removed from compact UX; kept for callback compat -->
    <TextView
        android:id="@+id/command_btn_pause"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
