<?xml version="1.0" encoding="utf-8"?>
<!-- Compact transcription card — anchored beside floating bubble -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/command_review_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_command_glass_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your message"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/command_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="0"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/command_btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/floating_command_icon_btn"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/command_transcript_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="Transcription will appear here…"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5"
        android:minHeight="48dp"
        android:padding="0dp"
        android:textColor="#F1F5F9"
        android:textColorHint="#64748B"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/command_review_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:indeterminateTint="#1E88FF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/command_review_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/command_execute_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#86EFAC"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/command_review_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/command_btn_cancel_review"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/command_btn_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/floating_command_send_btn"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="16dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
